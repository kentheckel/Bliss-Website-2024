{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {"source":"/deck","destination":"/deck/","permanent":false},
    {"source":"/clubamerica","destination":"/clubamerica/","permanent":false},
    {"source":"/spurs2026","destination":"/spurs2026/","permanent":false},
    {"source":"/hornets","destination":"/hornets/","permanent":false},
    {"source":"/utah","destination":"/utah/","permanent":false},
    {"source":"/allthesmokeOctober","destination":"/allthesmokeOctober/","permanent":false},
    {"source":"/giro","destination":"/giro/","permanent":false},
    {"source":"/texasAM","destination":"/texasAM/","permanent":false}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"Cache-Control","value":"private, no-store"}]},
    {"source":"/deck/assets/(.*)","headers":[{"key":"Cache-Control","value":"private, max-age=86400, stale-while-revalidate=604800"}]}
  ]
}
